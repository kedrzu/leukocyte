{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo run:*)",
      "Bash(cargo add:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo doc:*)",
      "Bash(scripts/verify.sh:*)",
      "Bash(scripts/verify-scoped.sh:*)",
      "Bash(bash scripts/verify.sh:*)",
      "Bash(bash scripts/verify-scoped.sh:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(cp:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git merge:*)",
      "Bash(git merge-base:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(gh:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(pwd:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(xargs:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "TodoWrite"
    ],
    "deny": [
      "ScheduleWakeup",
      "ReportFindings",
      "NotebookEdit",
      "DesignSync",
      "PushNotification",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "disableWorkflows": true,
  "disableBundledSkills": true,
  "disableArtifact": true,
  "agentPushNotifEnabled": false,
  "autoMemoryEnabled": false,
  "extraKnownMarketplaces": {
    "kedrzu-skills": {
      "source": {
        "source": "github",
        "repo": "kedrzu/skills"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "dev@kedrzu-skills": true,
    "git@kedrzu-skills": true,
    "web-search@kedrzu-skills": true,
    "guardrails@kedrzu-skills": true,
    "claude-md-management@claude-plugins-official": true
  }
}
